# ---------- Public (safe for browser; NEVER put secrets here) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_CHECK_SITE_KEY=
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_WHATSAPP_NUMBER=            # international format, digits only
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=      # Google Maps "Embed a map" URL (no API key)

# ---------- Server-only (use Secret Manager in deployed environments) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=                  # local dev only; use ADC on App Hosting
FIREBASE_PRIVATE_KEY=                   # local dev only; keep quoted, with \n escapes
SESSION_COOKIE_NAME=__session
SESSION_MAX_AGE_DAYS=5
BUSINESS_TIMEZONE=Asia/Kolkata
ADMIN_BOOTSTRAP_EMAIL=                  # first admin, consumed by scripts/bootstrap-admin.ts
